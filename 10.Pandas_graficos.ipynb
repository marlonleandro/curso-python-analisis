    "# Grafico de barras con data de censo USA 2017 de estados con población mayor a 10M\n",
    "census = pd.read_csv(\"data\\\\acs2017_county_data.csv\")\n",
    "state_pop = census.groupby(\"State\")\n",
    "state_pop_sum = state_pop.agg({'TotalPop': 'sum'})\n",
    "state_pop_sum_10m = state_pop_sum[state_pop_sum['TotalPop']>10000000]\n",
    "state_pop_sum_10m.plot(kind=\"bar\")\n",
    "\n",
    "plt.title(\"Estados con población mayor a 10M\", fontsize=12, fontweight='bold')\n",
    "plt.xlabel(\"Estado\", fontsize=11)  #Título del eje x\n",
    "plt.ylabel(\"Pobblación\", fontsize=11)  #Título del eje y\n",
    "plt.show()"
   ]
  }
